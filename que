Remove duplicate elements.

let array = [6, 5, 5, 4, 4, 4, 2, 8, 10];
const seen = new Set();
const dup = new Set();

for (const num of array) {
    if (seen.has(num)) {
        dup.add(num);
    } else {
        seen.add(num);
    }
}

console.log([...dup]);
